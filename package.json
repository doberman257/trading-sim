{
  "name": "trading-sim",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "quote": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/fetch-quote.ts",
    "check-db": "tsx scripts/check-db.ts",
    "check-node-engine": "tsx scripts/check-node-engine.ts",
    "sync-assets": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/sync-assets.ts",
    "apply-migration": "tsx scripts/apply-migration.ts",
    "db:push": "drizzle-kit push",
    "db:push:test": "drizzle-kit push --config drizzle.test.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check-node-engine && npm run typecheck && npm run test && npm run format:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "drizzle-orm": "^0.45.2",
    "lightweight-charts": "^5.2.0",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
