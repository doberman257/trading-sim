# Supabase's connection pooler URL (port 6543, pgbouncer transaction mode) -
# not the direct connection on port 5432. See lib/db/client.ts.
DATABASE_URL=
# Local test database for `npm run test:integration` - see docker-compose.test.yml.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/trading_sim_test
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bearer secret the limit-order worker route checks - only the scheduler
# (GitHub Actions today) and you need to know this. Not a user credential;
# generate any long random string, e.g. `openssl rand -hex 32`.
LIMIT_ORDER_WORKER_SECRET=
